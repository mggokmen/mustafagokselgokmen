# Copy to .env (gitignored) to run the API from an IDE or with ./mvnw spring-boot:run.
# Start the database first, from the repository root: docker compose up -d postgres
DB_URL=jdbc:postgresql://localhost:5433/mustafagokselgokmen
DB_USER=mustafagokselgokmen
# Required: the same value as POSTGRES_PASSWORD in the root .env.
DB_PASSWORD=

# Required: at least 32 random characters, for example the output of: openssl rand -base64 48
JWT_SECRET=
# Required: the web and iOS OAuth client IDs from Google Cloud, comma-separated.
GOOGLE_CLIENT_IDS=
# Optional: comma-separated emails that are granted the ADMIN role at sign-in.
ADMIN_EMAILS=
