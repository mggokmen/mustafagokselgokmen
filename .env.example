# Copy to .env (gitignored) and fill in the values. Read by docker compose.
POSTGRES_DB=mustafagokselgokmen
POSTGRES_USER=mustafagokselgokmen
# Required: choose a local password. docker compose refuses to start without it.
POSTGRES_PASSWORD=

# The notification service has a database and a role of its own, created on an empty data volume.
NOTIFICATION_DB=mustafagokselgokmen_notification
NOTIFICATION_DB_USER=notification
# Required: choose another local password.
NOTIFICATION_DB_PASSWORD=

# Required: at least 32 random characters, for example the output of: openssl rand -base64 48
JWT_SECRET=
# Required: the web and iOS OAuth client IDs from Google Cloud, comma-separated.
GOOGLE_CLIENT_IDS=
# Optional: comma-separated emails that are granted the ADMIN role at sign-in.
ADMIN_EMAILS=

# The web app runs the OAuth code flow itself, so it needs its own client and that client's secret.
# WEB_GOOGLE_CLIENT_ID is the web entry of GOOGLE_CLIENT_IDS above.
WEB_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_SECRET=
# Where the browser reaches the web app. It must match the redirect URI registered for that client.
WEB_APP_URL=http://localhost:3000
