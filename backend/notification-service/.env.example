# Copy to .env (gitignored) to run the notification service from an IDE or with
# ./mvnw spring-boot:run. Start the database and the broker first, from the repository root:
#   docker compose up -d postgres kafka
# This service has a database of its own, created by docker/postgres/init/create-databases.sh.
DB_URL=jdbc:postgresql://localhost:5433/mustafagokselgokmen_notification
DB_USER=notification
# Required: the same value as NOTIFICATION_DB_PASSWORD in the root .env.
DB_PASSWORD=

# The compose broker listens for the host on this address.
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
