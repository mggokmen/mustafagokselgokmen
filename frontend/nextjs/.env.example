# Copy to .env.local (gitignored) to run the web app from source.
# Start the backend first, from the repository root: docker compose up -d postgres kafka api

# The backend, without a trailing slash. In the compose stack this is http://api:8080.
API_BASE_URL=http://localhost:8080

# This app's own address. The OAuth redirect URI is built from it, so it must match the URI
# registered for the Google client: <APP_URL>/auth/google/callback
APP_URL=http://localhost:3000

# Required: the web OAuth client from Google Cloud. The secret stays on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only the tests point this somewhere else, at a mock provider.
# GOOGLE_ISSUER=https://accounts.google.com
