# Copy to .env on the server, next to compose.prod.yml, and fill it in.
# It holds production secrets: keep it readable by root only (chmod 600) and never commit it.

# The release to run. Images are pulled by this tag, so what runs is what CI built and scanned.
APP_VERSION=0.4.0

# The applications' own database (ADR-011), separate from the server's PostgreSQL 16.
POSTGRES_DB=mustafagokselgokmen
POSTGRES_USER=mustafagokselgokmen
# Required: generate one, for example: openssl rand -hex 24
POSTGRES_PASSWORD=

# Required: at least 32 random characters, for example: openssl rand -base64 48
JWT_SECRET=
# Required: the OAuth client IDs the API accepts in a Google ID token, comma-separated.
GOOGLE_CLIENT_IDS=
# Optional: comma-separated emails granted the ADMIN role at sign-in.
ADMIN_EMAILS=

# The address the browser uses. https, so session cookies are marked Secure.
WEB_APP_URL=https://mustafagokselgokmen.com.tr
# Required: the web OAuth client from Google Cloud. Its redirect URI must be
# <WEB_APP_URL>/auth/google/callback
WEB_GOOGLE_CLIENT_ID=
WEB_GOOGLE_CLIENT_SECRET=
