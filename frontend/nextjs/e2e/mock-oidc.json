{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "google",
      "tokenExpiry": 600,
      "requestMappings": [
        {
          "requestParam": "redirect_uri",
          "match": "http://localhost:3101/auth/google/callback",
          "claims": {
            "sub": "web-e2e-admin",
            "aud": ["web-e2e"],
            "email": "admin@example.com",
            "email_verified": true,
            "name": "Web End-to-end Admin"
          }
        },
        {
          "requestParam": "redirect_uri",
          "match": "http://localhost:3102/auth/google/callback",
          "claims": {
            "sub": "web-e2e-author",
            "aud": ["web-e2e"],
            "email": "author@example.com",
            "email_verified": true,
            "name": "Web End-to-end Author"
          }
        },
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "web-e2e-user",
            "aud": ["web-e2e"],
            "email": "user@example.com",
            "email_verified": true,
            "name": "Web End-to-end User"
          }
        }
      ]
    }
  ]
}
